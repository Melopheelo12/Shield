FROM python:3.12-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

COPY pyproject.toml ./
COPY src ./src
# /archive : seul dossier inscriptible du conteneur (racine en lecture seule).
RUN pip install --no-cache-dir . && \
    groupadd -g 10002 shield && useradd -u 10002 -g shield -s /usr/sbin/nologin shield && \
    mkdir /archive && chown 10002:10002 /archive

COPY rules ./rules
USER 10002:10002
EXPOSE 8000
CMD ["uvicorn", "shield.collector.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
