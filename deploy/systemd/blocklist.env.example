# /etc/shield/blocklist.env — configuration de scripts/apply_blocklist.sh
#   sudo install -m 600 -o root deploy/systemd/blocklist.env.example /etc/shield/blocklist.env

# Tableau de bord SHIELD (nginx). Certificat autosigné : CURL_OPTS="--cacert /chemin/ca.pem"
SHIELD_URL=https://127.0.0.1:8443
BLOCKLIST_TOKEN=change-me-blocklist-token

# Ports des VRAIS services à protéger, tels que le client les vise sur l'hôte (jamais
# ceux des leurres). Exemple : tableau de bord + vrai SSH sur 49222, le port par défaut
# de scripts/harden_vps.sh. Ne pas confondre avec les ports internes des conteneurs
# (2222, 8080, 2121, 4443) : ils ne comptent pas, le filtrage lit le port d'origine.
PROTECTED_PORTS="8443 49222"
DECOY_PORTS="22 80 21 443"

# OBLIGATOIRE : vos adresses d'administration, jamais bloquées (adresses ou CIDR).
ALLOWLIST="203.0.113.10"

# Adresses dont le pire score depuis DAYS jours atteint MIN_SCORE.
MIN_SCORE=60
DAYS=7
MAX_ENTRIES=5000

# 1 = affiche et vérifie sans appliquer. Passer à 0 après avoir relu le résultat.
DRY_RUN=1
