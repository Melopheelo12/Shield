# Image des leurres : volontairement minimale.
# Aucun shell utile, aucun outil reseau, aucun secret. Utilisateur non privilegie.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir . && \
    groupadd -g 10001 decoy && useradd -u 10001 -g decoy -s /usr/sbin/nologin decoy && \
    rm -rf /root/.cache

USER 10001:10001
CMD ["python", "-m", "shield.decoys.runner", "ssh"]
