# ---------------------------------------------------------------
# SHIELD — copiez ce fichier en .env et adaptez les valeurs.
# Ce fichier NE DOIT JAMAIS contenir de secret reel.
# ---------------------------------------------------------------

# Environnement : "prod" (hote expose) | "dev" | "sandbox"
# La sandbox REFUSE de demarrer si SHIELD_ENV=prod.
SHIELD_ENV=dev

# --- Base de donnees ---
POSTGRES_USER=shield
POSTGRES_PASSWORD=change-me-in-your-env
POSTGRES_DB=shield
DATABASE_URL=postgresql+asyncpg://shield:change-me-in-your-env@postgres:5432/shield

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Secret partage entre les leurres et le collecteur ---
# Genere avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_TOKEN=change-me-ingest-token

# --- Authentification du tableau de bord ---
JWT_SECRET=change-me-jwt-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
ACCESS_TOKEN_TTL_MINUTES=30

# --- Enrichissement ---
GEOLITE2_CITY_PATH=/data/geolite2/GeoLite2-City.mmdb
GEOLITE2_ASN_PATH=/data/geolite2/GeoLite2-ASN.mmdb
ABUSEIPDB_API_KEY=
ABUSEIPDB_CACHE_TTL_SECONDS=86400

# --- Alertes ---
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# --- Conservation des donnees (RGPD) ---
RETENTION_DAYS=365
PSEUDONYMIZE_EXPORTS=false

# --- Leurres ---
DECOY_SSH_PORT=22
DECOY_HTTP_PORT=80
DECOY_FTP_PORT=21
DECOY_SSH_BANNER=SSH-2.0-OpenSSH_8.9p1 Ubuntu-3ubuntu0.4
DECOY_FTP_BANNER=220 (vsFTPd 3.0.5)
COLLECTOR_INGEST_URL=http://collector:8000/api/v1/ingest
