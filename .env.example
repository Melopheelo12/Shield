# ---------------------------------------------------------------
# SHIELD — copiez ce fichier en .env et adaptez les valeurs.
# Ce fichier NE DOIT JAMAIS contenir de secret reel.
# ---------------------------------------------------------------

# Environnement : "prod" (hote expose) | "dev" | "sandbox"
# La sandbox REFUSE de demarrer si SHIELD_ENV=prod.
SHIELD_ENV=dev

# --- Base de donnees ---
# Stockage du collecteur : "postgres" (defaut) | "memory" (dev sans base, rien n'est conserve)
SHIELD_STORAGE=postgres
POSTGRES_USER=shield
POSTGRES_PASSWORD=change-me-in-your-env
POSTGRES_DB=shield
DATABASE_URL=postgresql+asyncpg://shield:change-me-in-your-env@postgres:5432/shield

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Secret partage entre les leurres et le collecteur ---
# Genere avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_TOKEN=change-me-ingest-token

# --- Authentification du tableau de bord ---
# 32 caracteres au moins : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
ACCESS_TOKEN_TTL_MINUTES=30

# --- Enrichissement ---
# GeoLite2 : compte gratuit sur maxmind.com, puis une clé de licence. Avec
# COMPOSE_PROFILES=geoip, le service geoipupdate télécharge les bases au
# démarrage puis toutes les 72 h. Après le tout premier téléchargement :
#   docker compose restart collector
COMPOSE_PROFILES=
GEOIPUPDATE_ACCOUNT_ID=
GEOIPUPDATE_LICENSE_KEY=
GEOLITE2_CITY_PATH=/data/geolite2/GeoLite2-City.mmdb
GEOLITE2_ASN_PATH=/data/geolite2/GeoLite2-ASN.mmdb
ABUSEIPDB_API_KEY=
ABUSEIPDB_CACHE_TTL_SECONDS=86400

# --- Alertes ---
# Adresse publique du tableau de bord : les alertes y renvoient, vue déjà filtrée.
DASHBOARD_URL=https://votre-serveur:8443
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# --- Liste de blocage (GET /api/v1/blocklist) ---
# Secret presente par un pare-feu dans l'en-tete X-Blocklist-Token. Vide : JWT seulement.
BLOCKLIST_TOKEN=

# --- Conservation des donnees (RGPD) ---
RETENTION_DAYS=365
PSEUDONYMIZE_EXPORTS=false
# Cycle de vie : charge utile effacee apres N jours (l'empreinte reste), mois archives en
# CSV compresse apres N mois puis retires de la base. 0 = palier desactive.
PAYLOAD_RETENTION_DAYS=30
ARCHIVE_AFTER_MONTHS=3
ARCHIVE_DIR=/archive

# --- Leurres ---
DECOY_SSH_PORT=22
DECOY_HTTP_PORT=80
DECOY_FTP_PORT=21
DECOY_HTTPS_PORT=443
DECOY_SSH_BANNER=SSH-2.0-OpenSSH_8.9p1 Ubuntu-3ubuntu0.4
DECOY_FTP_BANNER=220 (vsFTPd 3.0.5)
# Leurre HTTP : site vitrine WordPress d'une entreprise FICTIVE (jamais une marque reelle)
DECOY_HTTP_BANNER=nginx/1.18.0
DECOY_HTTP_SITE_NAME=Menuiserie des Tilleuls
COLLECTOR_INGEST_URL=http://collector:8000/api/v1/ingest
